# ============================================================
# Vaultwarden environment configuration
# Copy to .env and fill in your values.
# NOTE: DOMAIN must always include the protocol (https://)
# ============================================================

# ── Core ─────────────────────────────────────────────────────
# Local testing:  DOMAIN=https://localhost
# Production:     DOMAIN=https://vault.yourdomain.com
DOMAIN=https://localhost

# Set to false after creating your first account
SIGNUPS_ALLOWED=true

# Admin panel token — generate with:
#   docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
# Paste the full $argon2id$... string here
ADMIN_TOKEN=

# Logging
LOG_LEVEL=info

# Your timezone (for Fail2Ban log timestamps)
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago

# Your public IP — restricts /admin panel access to this address only.
# Find yours: curl https://api.ipify.org
# Defaults to 127.0.0.1 (localhost only) if unset.
ADMIN_ALLOWED_IP=

# ── Grocy ─────────────────────────────────────────────────────────────────────
# Local testing:  GROCY_DOMAIN=grocy.localhost  (add to hosts file or use caddy trust)
# Production:     GROCY_DOMAIN=grocy.yourdomain.com
GROCY_DOMAIN=grocy.localhost

# ── Obsidian Sync (CouchDB + Self-hosted LiveSync) ─────────────────────────────
# Local testing:  OBSIDIAN_DOMAIN=obsidian.localhost
# Production:     OBSIDIAN_DOMAIN=obsidian.yourdomain.com
OBSIDIAN_DOMAIN=obsidian.localhost

# CouchDB admin credentials — the Obsidian LiveSync plugin connects with these.
# CouchDB is reached from many devices/networks, so there's no IP restriction;
# use a strong, unique password (e.g. openssl rand -base64 24).
COUCHDB_USER=admin
COUCHDB_PASSWORD=

# ── Cloudflare Tunnel (optional alternative to direct port 443) ──
# Only needed if using: docker compose --profile tunnel up -d
# See docs/cloudflare-setup.md for setup instructions
# CLOUDFLARE_TUNNEL_TOKEN=
# IP_HEADER=CF-Connecting-IP

# ── SMTP (optional — for email notifications) ────────────────
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vaultwarden@yourdomain.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ── Database (optional — SQLite is fine for up to ~10 users) ─
# Uncomment to use PostgreSQL instead:
# DATABASE_URL=postgresql://vw_user:vw_password@postgres:5432/vaultwarden

# ── Push notifications (optional) ────────────────────────────
# Requires a Bitwarden installation ID/key from:
# https://bitwarden.com/host/
# PUSH_ENABLED=true
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=

# ── Docker image update notifications (optional) ──────────────
# scripts/check-image-updates.sh checks daily for newer image versions
# and (if set) posts a free push notification via https://ntfy.sh —
# pick any topic name, then subscribe to it in the ntfy app or with
# `curl -s https://ntfy.sh/<topic>/json`. It never auto-applies updates;
# review and run `docker compose --profile caddy pull && up -d` yourself.
# NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh
