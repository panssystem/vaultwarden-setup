# Copy this to .env and fill in your values
# For local testing: DOMAIN=https://localhost
# For production: DOMAIN=https://your.domain.com

DOMAIN=https://localhost

# Set to false after creating your account
SIGNUPS_ALLOWED=true

# Generate with: docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
# Then paste the full $argon2id$... string here
ADMIN_TOKEN=

# Set to warn or error in production
LOG_LEVEL=info

# SMTP (optional - for email notifications/verification)
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vaultwarden@example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgresql://vw_user:vw_password@postgres:5432/vaultwarden

# Push notifications (optional - requires Bitwarden account)
# PUSH_ENABLED=true
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=
