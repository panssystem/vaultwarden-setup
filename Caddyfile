# Caddy reverse proxy for Vaultwarden and Grocy.
# Env vars (set in .env, passed through docker-compose.yml):
#   DOMAIN            — Vaultwarden hostname (e.g. vault.kaosklan.net or localhost)
#   GROCY_DOMAIN      — Grocy hostname       (e.g. grocy.kaosklan.net or grocy.localhost)
#   ADMIN_ALLOWED_IP  — IP allowed to reach Vaultwarden /admin (default: 127.0.0.1)
#
# Caddy auto-issues:
#   localhost / *.localhost → self-signed cert (caddy trust to install CA)
#   real domain             → Let's Encrypt cert

# ── Vaultwarden ───────────────────────────────────────────────────────────────

{$DOMAIN:localhost} {

    # /admin — restricted to ADMIN_ALLOWED_IP
    @admin path /admin*
    handle @admin {
        @allowed_admin remote_ip {$ADMIN_ALLOWED_IP:127.0.0.1}
        handle @allowed_admin {
            reverse_proxy vaultwarden:80 {
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}
            }
        }
        respond 403
    }

    # All other traffic
    reverse_proxy vaultwarden:80 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer"
    }

    log {
        output stdout
        format console
    }
}

# ── Grocy ─────────────────────────────────────────────────────────────────────

{$GROCY_DOMAIN:grocy.localhost} {

    reverse_proxy grocy:80 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer"
    }

    log {
        output stdout
        format console
    }
}
